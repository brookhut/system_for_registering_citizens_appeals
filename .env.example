# Database configuration
# Если для postgres задан пароль (например, postgres), укажите его в DB_PASSWORD и DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appeals_db
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres@localhost:5432/appeals_db
# Пример с паролем 'postgres':
# DB_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appeals_db

# Built-in SuperAdmin Account
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperAdminPass2026!
SUPERADMIN_FULL_NAME=Главный администратор

# Flask application configuration
SECRET_KEY=citizens-appeals-secret-key-change-me
FLASK_ENV=production
PORT=5000
